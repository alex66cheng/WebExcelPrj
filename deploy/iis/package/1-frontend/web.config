<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for the frontend IIS application (__APP_PATH__). build-packages.sh fills in
  __APP_PATH__ and copies this next to the built dist/. Needs IIS URL Rewrite, ARR
  with its proxy enabled, and the WebSocket Protocol feature (Install-Frontend.ps1
  checks them).

    __APP_PATH__/api/*          reverse-proxied to WebSideAPI on http://127.0.0.1:3000/api/*
    __APP_PATH__/excel-room-*   same, as WebSockets (Yjs collaboration rooms)
    everything else             static files; unknown paths fall back to index.html (SPA routes)

  Match URLs are relative to this application, so "api/..." is __APP_PATH__/api/...
  127.0.0.1, not localhost: WebSideAPI listens on IPv4 only, and localhost can resolve to ::1.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <clear />
          <rule name="WebExcel API" stopProcessing="true">
            <match url="^api/(.*)" />
            <action type="Rewrite" url="http://127.0.0.1:3000/api/{R:1}" />
          </rule>
          <rule name="WebExcel collaboration WebSockets" stopProcessing="true">
            <match url="^(excel-room-.*)" />
            <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          </rule>
          <rule name="WebExcel SPA fallback" stopProcessing="true">
            <match url=".*" />
            <conditions logicalGrouping="MatchAll">
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            </conditions>
            <action type="Rewrite" url="__APP_PATH__/index.html" />
          </rule>
        </rules>
      </rewrite>

      <!-- WebSideAPI accepts 50 MB uploads / JSON bodies; IIS's default cap is ~28.6 MB. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>

      <staticContent>
        <remove fileExtension=".json" />
        <mimeMap fileExtension=".json" mimeType="application/json" />
        <remove fileExtension=".woff2" />
        <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        <remove fileExtension=".mjs" />
        <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      </staticContent>

      <defaultDocument enabled="true">
        <files>
          <clear />
          <add value="index.html" />
        </files>
      </defaultDocument>

      <!-- Opening a large .xlsm returns tens of MB of JSON; compress proxied API responses too. -->
      <urlCompression doStaticCompression="true" doDynamicCompression="true" />

      <httpProtocol>
        <customHeaders>
          <remove name="X-Content-Type-Options" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- Vite puts content-hashed bundles in assets/, so they can be cached forever... -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- ...while index.html must always be revalidated so a redeploy is picked up immediately. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
